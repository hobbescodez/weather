# Copy this file to .env (already gitignored) and fill in real values.
# Never commit .env - it holds your phone number and API credentials.

# Digits only, no +1 / dashes / spaces.
ALERT_PHONE_NUMBER=5551234567

# Twilio (https://twilio.com) - free trial credit covers plenty of texts.
# Sign up, get a trial phone number, and copy these from the console.
# Raw SMTP and email-to-SMS gateways don't work here: SMTP is blocked by
# this sandbox's network policy, and email APIs like Resend restrict
# unverified accounts to sending only to your own address, not a
# carrier gateway. Twilio's REST API sends the SMS directly - no
# gateway, no domain verification needed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
