# Copy this file to .env (already gitignored) and fill in real values.
# Never commit .env - it holds your phone number and API key.

# Digits only, no +1 / dashes / spaces.
ALERT_PHONE_NUMBER=5551234567

# Your carrier's email-to-SMS gateway domain, e.g.:
#   Verizon:   vtext.com
#   AT&T:      txt.att.net
#   T-Mobile:  tmomail.net
ALERT_CARRIER_GATEWAY=tmomail.net

# Resend API key (https://resend.com) - free tier is plenty for this.
# Sign up, create an API key, paste it below. Raw SMTP doesn't work from
# this sandbox (only HTTPS egress is allowed), so alerts send through
# Resend's HTTPS API instead of smtplib.
RESEND_API_KEY=

# onboarding@resend.dev works immediately with zero setup on a fresh
# Resend account (fine for this use case). If you verify your own domain
# with Resend later, you can use an address on it instead.
ALERT_FROM_EMAIL=onboarding@resend.dev
